# VITE_* values are compiled into the public client bundle — never put a secret here.
# Left blank in dev: the Vite proxy (see vite.config.ts) handles /api requests locally.
# Set only for production builds pointing at a deployed API origin.
VITE_API_URL=

# The OAuth 2.0 Client ID from Google Cloud Console (ends in .apps.googleusercontent.com).
# Public by design — it identifies the app, it does not authenticate it. Leave blank to
# render today's disabled "coming soon" Google button instead of a live one.
VITE_GOOGLE_CLIENT_ID=
